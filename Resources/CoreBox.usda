#usda 1.0
(
    defaultPrim = "BoxRoot"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "BoxRoot" {
    def Cube "BoxBody" {
        double size = 1
        float3 xformOp:scale = (0.30, 0.16, 0.22)
        float3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
    def Xform "LidPivot" {
        float3 xformOp:translate = (0, 0.055, -0.10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "LidMesh" {
            double size = 1
            float3 xformOp:scale = (0.31, 0.035, 0.23)
            float3 xformOp:translate = (0, 0, 0.10)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
    }
    def Cube "RibbonRoot" {
        double size = 1
        float3 xformOp:scale = (0.038, 0.006, 0.12)
        float3 xformOp:translate = (0, 0.055, 0.16)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
    }
    def Xform "PaperPool" {}
    def Xform "PaperReveal" {}
    def Xform "CurrentPaperAnchor" {}
    def Xform "MemorySeam" {}
    def Xform "Ground" {}
    def Xform "Camera_Default" {}
    def Xform "Camera_Overview" {}
    def Xform "Light_Key" {}
    def Xform "Light_Fill" {}
}
